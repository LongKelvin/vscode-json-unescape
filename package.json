{
  "name": "json-unescape-formatter",
  "displayName": "JSON Unescape & Formatter",
  "description": "Convert escaped JSON strings into pretty JSON and reverse. Clipboard, context menu, and keybinding support.",
  "version": "1.0.0",
  "publisher": "LongKelvin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LongKelvin/vscode-json-unescape.git"
  },
  "categories": [
    "Formatters",
    "Other"
  ],
  "keywords": [
    "json",
    "formatter",
    "unescape",
    "escape",
    "pretty",
    "format",
    "clipboard"
  ],
  "engines": {
    "vscode": "^1.75.0"
  },
  "main": "./out/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "pretest": "npm run compile",
    "package": "vsce package",
    "build": "npm run compile && npm run package"
  },
  "contributes": {
    "commands": [
      {
        "command": "extension.convertToJson",
        "title": "Unescape & Format JSON"
      },
      {
        "command": "extension.convertSelectionToJson",
        "title": "Unescape Selected Escaped JSON"
      },
      {
        "command": "extension.convertClipboardToJson",
        "title": "Unescape JSON from Clipboard"
      },
      {
        "command": "extension.convertToEscaped",
        "title": "Convert JSON → Escaped String"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "extension.convertSelectionToJson",
          "when": "editorHasSelection",
          "group": "navigation"
        },
        {
          "command": "extension.convertToEscaped",
          "when": "editorHasSelection",
          "group": "navigation"
        }
      ]
    },
    "keybindings": [
      {
        "command": "extension.convertToJson",
        "key": "ctrl+alt+j",
        "when": "editorTextFocus"
      }
    ]
  },
  "devDependencies": {
    "@types/vscode": "^1.75.0",
    "typescript": "^4.9.0",
    "tslint": "^6.1.3"
  }
}
